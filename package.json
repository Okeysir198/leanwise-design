{
  "name": "@leanwise/design",
  "version": "5.1.0",
  "description": "LeanWise brand as a shadcn/ui theme and registry: theme.css for Tailwind v4, brand registry items, marketing layer.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./marketing.css": "./marketing.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./brand": {
      "types": "./brand.d.ts",
      "default": "./brand.js"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "default": "./hooks.js"
    },
    "./tokens.json": "./tokens.json",
    "./r/*": "./r/*",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "lw-token-lint": "./bin/lw-token-lint.mjs"
  },
  "files": [
    "theme.css",
    "marketing.css",
    "fonts.css",
    "fonts",
    "assets",
    "brand.js",
    "brand.d.ts",
    "hooks.js",
    "hooks.d.ts",
    "tokens.json",
    "r",
    "registry.json",
    "bin",
    "scripts/lib/lint.mjs",
    "scripts/lib/report.mjs",
    "skills",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs && node scripts/assets.mjs && node scripts/favicon.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "node scripts/check.mjs lint",
    "check": "node scripts/gen.mjs --check && node scripts/assets.mjs --check && node scripts/favicon.mjs --check && npm test && tsc --noEmit && node scripts/check.mjs lint && node scripts/check.mjs contrast && node scripts/check.mjs presence && node scripts/affordance.mjs --self-test && node scripts/affordance.mjs && node scripts/templates.mjs",
    "check:ci": "npm run check && npm run check:pack && npm run check:a11y && node scripts/forced-colors.mjs && npm run check:visual -- --self-test",
    "check:pack": "node scripts/check.mjs pack",
    "check:a11y": "node scripts/check.mjs a11y",
    "check:visual": "node scripts/check.mjs visual"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.18",
    "axe-core": "^4.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.27.7",
    "lucide-react": "^0.544.0",
    "playwright": "^1.48.0",
    "postcss": "^8.5.25",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okeysir198/leanwise-design.git"
  },
  "engines": {
    "node": ">=20"
  }
}
