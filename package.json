{
  "name": "@leanwise/design",
  "version": "1.3.0",
  "description": "LeanWise Design System — token core, CSS layers, React components, twelve templates.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./react.js",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "types": "./react.d.ts",
      "source": "./react.js",
      "default": "./dist/react.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "source": "./react.js",
      "default": "./dist/react.js"
    },
    "./brand": {
      "types": "./brand.d.ts",
      "source": "./brand.js",
      "default": "./dist/brand.js"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "source": "./hooks.js",
      "default": "./dist/hooks.js"
    },
    "./counter": {
      "types": "./hooks.d.ts",
      "source": "./hooks.js",
      "default": "./dist/hooks.js"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.cts",
      "require": "./tailwind-preset.cjs",
      "default": "./tailwind-preset.cjs"
    },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./shadcn.css": "./shadcn.css",
    "./theme.css": "./theme.css",
    "./reset.css": "./reset.css",
    "./base.css": "./base.css",
    "./marketing.css": "./marketing.css",
    "./product.css": "./product.css",
    "./lw.css": "./lw.css",
    "./app.css": "./app.css",
    "./email.css": "./email.css",
    "./tokens.json": "./tokens.json",
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json",
    "./r/*": "./r/*",
    "./registry.json": "./registry/registry.json",
    "./advisories.json": "./advisories.json"
  },
  "bin": {
    "lw-token-lint": "./tools/lw-token-lint.mjs",
    "lw-doctor": "./tools/lw-doctor.mjs"
  },
  "files": [
    "react.js",
    "react.d.ts",
    "brand.js",
    "brand.d.ts",
    "hooks.js",
    "hooks.d.ts",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts",
    "tokens.css",
    "fonts.css",
    "shadcn.css",
    "theme.css",
    "reset.css",
    "base.css",
    "marketing.css",
    "product.css",
    "lw.css",
    "app.css",
    "email.css",
    "tokens.json",
    "dist",
    "components",
    "assets",
    "fonts",
    "tools",
    "README.md",
    "tsconfig.json",
    "r",
    "registry",
    "advisories.json"
  ],
  "scripts": {
    "build": "node tools/lw-build.mjs",
    "check:contrast": "node tools/lw-contrast-check.mjs",
    "check:tokens": "node tools/lw-token-lint.mjs --css && node tools/lw-token-lint.mjs registry",
    "check:themes": "node tools/lw-tokens-dtcg.mjs --check",
    "check:dts": "node tools/lw-dts-barrel.mjs --check",
    "check:bundle": "node tools/lw-bundle.mjs --check",
    "check:templates": "node tools/lw-templates.mjs",
    "check:a11y": "node tools/lw-a11y.mjs",
    "check:visual": "node tools/lw-visual.mjs",
    "check:presence": "node tools/lw-presence.mjs",
    "check:presence:list": "node tools/lw-presence.mjs --list",
    "check": "npm run check:presence && npm run check:rsc && npm run check:build && npm run check:types && npm run check:registry && npm run check:advisories && npm run check:contrast && npm run check:tokens && npm run check:themes && npm run check:dts && npm run check:bundle && npm run check:templates",
    "check:ci": "npm run check && npm run check:pack && npm run check:a11y && npm run check:visual",
    "tokens": "node tools/lw-tokens-dtcg.mjs",
    "dts": "node tools/lw-dts-barrel.mjs",
    "bundle": "node tools/lw-bundle.mjs",
    "prepublishOnly": "npm run check && npm run tokens && npm run dts && npm run bundle && npm run registry && npm run build",
    "check:build": "node tools/lw-build.mjs --check",
    "rsc": "node tools/lw-rsc.mjs",
    "check:rsc": "node tools/lw-rsc.mjs --check",
    "check:types": "tsc --noEmit",
    "check:pack": "node tools/lw-pack-check.mjs",
    "registry": "node tools/lw-registry.mjs",
    "check:registry": "node tools/lw-registry.mjs --check",
    "check:advisories": "node tools/lw-doctor.mjs --self-check"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.10.0",
    "esbuild": "^0.27.7",
    "playwright": "^1.48.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okeysir198/leanwise-design.git"
  },
  "engines": {
    "node": ">=18"
  }
}
