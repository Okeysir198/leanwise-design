{
  "name": "@leanwise/design",
  "version": "1.1.8",
  "description": "LeanWise Design System — token core, CSS layers, React components, twelve templates.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./react.js",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./brand": {
      "types": "./brand.d.ts",
      "default": "./brand.js"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "default": "./hooks.js"
    },
    "./counter": {
      "types": "./hooks.d.ts",
      "default": "./hooks.js"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.cts",
      "require": "./tailwind-preset.cjs",
      "default": "./tailwind-preset.cjs"
    },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./shadcn.css": "./shadcn.css",
    "./theme.css": "./theme.css",
    "./reset.css": "./reset.css",
    "./base.css": "./base.css",
    "./marketing.css": "./marketing.css",
    "./product.css": "./product.css",
    "./lw.css": "./lw.css",
    "./app.css": "./app.css",
    "./email.css": "./email.css",
    "./tokens.json": "./tokens.json",
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "lw-token-lint": "./templates/_tooling/lw-token-lint.mjs"
  },
  "files": [
    "react.js",
    "react.d.ts",
    "brand.js",
    "brand.d.ts",
    "hooks.js",
    "hooks.d.ts",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts",
    "tokens.css",
    "fonts.css",
    "shadcn.css",
    "theme.css",
    "reset.css",
    "base.css",
    "marketing.css",
    "product.css",
    "lw.css",
    "app.css",
    "email.css",
    "tokens.json",
    "components",
    "assets",
    "fonts",
    "templates",
    "!templates/_tooling",
    "templates/_tooling/lw-token-lint.mjs",
    "templates/_tooling/_css.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config templates/_tooling/tsup.config.js",
    "check:contrast": "node templates/_tooling/lw-contrast-check.mjs",
    "check:tokens": "node templates/_tooling/lw-token-lint.mjs --css",
    "check:themes": "node templates/_tooling/lw-tokens-dtcg.mjs --check",
    "check:dts": "node templates/_tooling/lw-dts-barrel.mjs --check",
    "check:bundle": "node templates/_tooling/lw-bundle.mjs --check",
    "check:templates": "node templates/_tooling/lw-templates.mjs",
    "check:a11y": "node templates/_tooling/lw-a11y.mjs",
    "check:visual": "node templates/_tooling/lw-visual.mjs",
    "check:presence": "node templates/_tooling/lw-presence.mjs",
    "check:presence:list": "node templates/_tooling/lw-presence.mjs --list",
    "check": "npm run check:presence && npm run check:contrast && npm run check:tokens && npm run check:themes && npm run check:dts && npm run check:bundle && npm run check:templates",
    "check:ci": "npm run check && npm run check:a11y && npm run check:visual",
    "tokens": "node templates/_tooling/lw-tokens-dtcg.mjs",
    "dts": "node templates/_tooling/lw-dts-barrel.mjs",
    "bundle": "node templates/_tooling/lw-bundle.mjs",
    "prepublishOnly": "npm run check && npm run tokens && npm run dts && npm run bundle && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "axe-core": "^4.10.0",
    "esbuild": "^0.27.7",
    "playwright": "^1.48.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okeysir198/leanwise-design.git"
  },
  "engines": {
    "node": ">=18"
  }
}
