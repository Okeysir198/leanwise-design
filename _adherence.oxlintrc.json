{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand.js",
              "components/ai/**",
              "components/data/**",
              "components/forms/**",
              "components/layout/**",
              "components/marketing/**",
              "components/nav/**",
              "components/overlays/**",
              "components/primitives/**",
              "hooks.js",
              "react.js",
              "tailwind-preset.cjs"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|when|meta|icon|tone|unread|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ActivityItem> doesn't accept that prop. Declared props: id, title, when, meta, icon, tone, unread, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|err)$/]",
        "message": "<ActivityItem> tone must be one of 'ok' | 'warn' | 'err'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|state|key|ref|className|style|children)$/]",
        "message": "<TraceStep> doesn't accept that prop. Declared props: label, meta, state."
