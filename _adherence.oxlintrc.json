      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|active|done|error)$/]",
        "message": "<TraceStep> state must be one of 'pending' | 'active' | 'done' | 'error'."
